<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SmartAccess.LoginPage"
             BackgroundColor="#121212"
             Shell.NavBarIsVisible="False"
             Title="Login">

    <ScrollView>
        <Grid Padding="28" RowDefinitions="*,Auto,*">

            <VerticalStackLayout Grid.Row="1" Spacing="22" MaximumWidthRequest="420" HorizontalOptions="Center">

                <!-- Logo -->
                <VerticalStackLayout Spacing="14" HorizontalOptions="Center" Margin="0,0,0,8">
                    <Border StrokeShape="RoundRectangle 20"
                            Stroke="#2A3A1E"
                            BackgroundColor="#1A2610"
                            HeightRequest="72" WidthRequest="72"
                            HorizontalOptions="Center">
                        <Image Source="icon_lock_accent.png" WidthRequest="34" HeightRequest="34"
                               HorizontalOptions="Center" VerticalOptions="Center"/>
                    </Border>
                    <Label Text="SMART ACCESS"
                           TextColor="#DEFF9A"
                           FontSize="24"
                           FontAttributes="Bold"
                           CharacterSpacing="3"
                           HorizontalOptions="Center"/>
                    <Label Text="Smart home access control"
                           TextColor="#666666"
                           FontSize="13"
                           HorizontalOptions="Center"/>
                </VerticalStackLayout>

                <!-- Mesaj de eroare -->
                <Border x:Name="ErrorBanner"
                        StrokeShape="RoundRectangle 10"
                        Stroke="#5A1010"
                        BackgroundColor="#2A1010"
                        Padding="14,10"
                        IsVisible="False"
                        StrokeThickness="1">
                    <Label x:Name="ErrorText"
                           Text=""
                           TextColor="#FF7777"
                           FontSize="13"/>
                </Border>

                <!-- Adresa serverului -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Server address" TextColor="#888888" FontSize="12" CharacterSpacing="0.5"/>
                    <Border StrokeShape="RoundRectangle 10" Stroke="#2A2A2A" BackgroundColor="#1C1C1C" Padding="14,4" StrokeThickness="1">
                        <Entry x:Name="EntServer"
                               Placeholder="http://192.168.0.52:3000"
                               PlaceholderColor="#444444"
                               TextColor="White"
                               Keyboard="Url"
                               BackgroundColor="Transparent"
                               FontSize="14"/>
                    </Border>
                </VerticalStackLayout>

                <!-- Email -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Email" TextColor="#888888" FontSize="12" CharacterSpacing="0.5"/>
                    <Border StrokeShape="RoundRectangle 10" Stroke="#2A2A2A" BackgroundColor="#1C1C1C" Padding="14,4" StrokeThickness="1">
                        <Entry x:Name="EntEmail"
                               Placeholder="admin@smartaccess.local"
                               PlaceholderColor="#444444"
                               TextColor="White"
                               Keyboard="Email"
                               BackgroundColor="Transparent"
                               FontSize="15"/>
                    </Border>
                </VerticalStackLayout>

                <!-- Parola -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Password" TextColor="#888888" FontSize="12" CharacterSpacing="0.5"/>
                    <Border StrokeShape="RoundRectangle 10" Stroke="#2A2A2A" BackgroundColor="#1C1C1C" Padding="14,4" StrokeThickness="1">
                        <Entry x:Name="EntPassword"
                               Placeholder="••••••••"
                               PlaceholderColor="#444444"
                               TextColor="White"
                               IsPassword="True"
                               BackgroundColor="Transparent"
                               FontSize="15"
                               Completed="OnLoginClicked"/>
                    </Border>
                </VerticalStackLayout>

                <!-- Autentificare -->
                <Button x:Name="BtnLogin"
                        Text="SIGN IN"
                        BackgroundColor="#DEFF9A"
                        TextColor="#121212"
                        FontAttributes="Bold"
                        FontSize="15"
                        CornerRadius="12"
                        HeightRequest="52"
                        CharacterSpacing="1"
                        Clicked="OnLoginClicked"
                        Margin="0,6,0,0">
                    <Button.Shadow>
                        <Shadow Brush="#DEFF9A" Offset="0,2" Radius="14" Opacity="0.25"/>
                    </Button.Shadow>
                </Button>

                <ActivityIndicator x:Name="LoginSpinner"
                                   IsRunning="False"
                                   IsVisible="False"
                                   Color="#DEFF9A"
                                   HorizontalOptions="Center"/>

                <Label Text="SmartAccess · Home Security"
                       TextColor="#3A3A3A"
                       FontSize="11"
                       HorizontalOptions="Center"
                       Margin="0,8,0,0"/>
            </VerticalStackLayout>
        </Grid>
    </ScrollView>
</ContentPage>
