<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:SmartAccess.Models"
             x:Class="SmartAccess.FamilyPage"
             x:Name="PageRoot"
             BackgroundColor="#121212"
             Title="Members">

    <Grid>

        <!-- Continut principal -->
        <Grid RowDefinitions="Auto,*" Padding="20,16,20,16">

            <VerticalStackLayout Grid.Row="0" Spacing="2" Margin="2,8,0,14">
                <Label Text="Members" TextColor="#DEFF9A" FontSize="22" FontAttributes="Bold"/>
                <Label x:Name="Subtitle" Text="Household access management" TextColor="#666666" FontSize="12"/>
            </VerticalStackLayout>

            <RefreshView Grid.Row="1" x:Name="Refresher" Refreshing="OnRefreshing">
                <CollectionView x:Name="MembersList" SelectionMode="None">
                    <CollectionView.EmptyView>
                        <VerticalStackLayout HorizontalOptions="Center" VerticalOptions="Center" Spacing="12" Padding="30">
                            <Border StrokeShape="RoundRectangle 30" Stroke="Transparent" BackgroundColor="#1A1A1A"
                                    HeightRequest="80" WidthRequest="80" HorizontalOptions="Center">
                                <Image Source="icon_users.png" WidthRequest="36" HeightRequest="36" HorizontalOptions="Center" VerticalOptions="Center" Opacity="0.5"/>
                            </Border>
                            <Label Text="No members registered" TextColor="#555555" FontSize="15" FontAttributes="Bold" HorizontalOptions="Center"/>
                            <Label Text="Invite members via the Admin panel" TextColor="#444444" FontSize="12" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Member">
                            <Border StrokeShape="RoundRectangle 14" Stroke="#2A2A2A" BackgroundColor="#1A1A1A"
                                    Padding="16,14" Margin="0,0,0,10" StrokeThickness="1">
                                <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="14">

                                    <!-- Avatar cu indicatorul acasa/plecat -->
                                    <Grid Grid.Column="0" WidthRequest="46" HeightRequest="46" VerticalOptions="Center">
                                        <Border StrokeShape="RoundRectangle 23" Stroke="#2A3A1E" BackgroundColor="#1E3A10" HeightRequest="46" WidthRequest="46">
                                            <Label Text="{Binding Initial}" TextColor="#DEFF9A" FontSize="18" FontAttributes="Bold"
                                                   HorizontalOptions="Center" VerticalOptions="Center"/>
                                        </Border>
                                        <Ellipse WidthRequest="13" HeightRequest="13" Fill="{Binding HomeBrush}" Stroke="#1A1A1A" StrokeThickness="2"
                                                 HorizontalOptions="End" VerticalOptions="End"/>
                                    </Grid>

                                    <!-- Nume + insigne -->
                                    <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="5">
                                        <HorizontalStackLayout Spacing="8">
                                            <Label Text="{Binding FullName}" TextColor="White" FontSize="15" FontAttributes="Bold" VerticalOptions="Center"/>
                                            <Border IsVisible="{Binding IsAdminRole}" StrokeShape="RoundRectangle 6" Stroke="Transparent"
                                                    BackgroundColor="#3A2E10" Padding="7,3" VerticalOptions="Center">
                                                <Label Text="Admin" TextColor="#FFAA33" FontSize="10"/>
                                            </Border>
                                        </HorizontalStackLayout>
                                        <Border StrokeShape="RoundRectangle 6" Stroke="Transparent" BackgroundColor="#222222"
                                                Padding="7,3" HorizontalOptions="Start">
                                            <Label Text="{Binding FingerprintBadge}" TextColor="{Binding FingerprintBadgeColor}"
                                                   FontSize="10" LineBreakMode="NoWrap"/>
                                        </Border>
                                    </VerticalStackLayout>

                                    <!-- Starea acasa/plecat. Latimea e plafonata, altfel un text lung
                                         ar inghesui insigna de amprenta din coloana de langa. -->
                                    <Label Grid.Column="2" Text="{Binding HomeStatus}" TextColor="{Binding HomeColor}"
                                           FontSize="12" FontAttributes="Bold" VerticalOptions="Center"
                                           HorizontalTextAlignment="End" LineBreakMode="WordWrap"
                                           MaximumWidthRequest="100" Margin="6,0,0,0"/>

                                    <!-- 3-dot menu (admin only) -->
                                    <Button Grid.Column="3" x:Name="OptionsBtn" Text="⋮" BackgroundColor="Transparent" TextColor="#888888"
                                            FontSize="22" WidthRequest="40" HeightRequest="44" Padding="0" Margin="0" VerticalOptions="Center"
                                            IsVisible="{Binding Source={x:Reference PageRoot}, Path=IsAdminUser}"
                                            Clicked="OnMemberOptions"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </RefreshView>
        </Grid>

        <!-- Fereastra de inrolare -->
        <Grid x:Name="ModalOverlay" IsVisible="False">
            <BoxView BackgroundColor="#CC000000">
                <BoxView.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnCloseOverlay"/>
                </BoxView.GestureRecognizers>
            </BoxView>

            <Border StrokeShape="RoundRectangle 20" Stroke="#2A2A2A" BackgroundColor="#1A1A1A"
                    Padding="24,22" Margin="24" MaximumWidthRequest="420"
                    HorizontalOptions="Center" VerticalOptions="Center" StrokeThickness="1">
                <Border.Shadow>
                    <Shadow Brush="#000000" Offset="0,8" Radius="24" Opacity="0.7"/>
                </Border.Shadow>

                <VerticalStackLayout Spacing="14" WidthRequest="320">

                    <Grid ColumnDefinitions="*,Auto">
                        <Label Grid.Column="0" Text="ENROLLMENT IN PROGRESS" TextColor="#DEFF9A" FontSize="11"
                               FontAttributes="Bold" CharacterSpacing="1.5" VerticalOptions="Center"/>
                        <ActivityIndicator x:Name="EnrollSpinner" Grid.Column="1" IsRunning="True" Color="#DEFF9A"
                                           WidthRequest="20" HeightRequest="20" VerticalOptions="Center"/>
                    </Grid>

                    <BoxView HeightRequest="1" Color="#1E3A10"/>

                    <!-- Step 1 -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" Margin="0,4,0,0">
                        <Border Grid.Column="0" x:Name="Step1Icon" StrokeShape="RoundRectangle 16" Stroke="#1E3A10" BackgroundColor="#1E3A10" HeightRequest="32" WidthRequest="32">
                            <Label Text="✓" FontSize="14" TextColor="#DEFF9A" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label x:Name="Step1Title" Text="Enrollment started" TextColor="#DEFF9A" FontSize="14" FontAttributes="Bold"/>
                            <Label x:Name="Step1Subtitle" Text="Command sent" TextColor="#666666" FontSize="11"/>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Step 2 -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Grid.Column="0" x:Name="Step2Icon" StrokeShape="RoundRectangle 16" Stroke="#2A2A2A" BackgroundColor="#1A1A1A" HeightRequest="32" WidthRequest="32">
                            <Label x:Name="Step2IconLabel" Text="2" FontSize="13" TextColor="#555555" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label x:Name="Step2Title" Text="Place your finger" TextColor="#555555" FontSize="14" FontAttributes="Bold"/>
                            <Label x:Name="Step2Subtitle" Text="Place finger on the sensor" TextColor="#444444" FontSize="11"/>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Fingerprint animation -->
                    <Border x:Name="CardAnimationBox" StrokeShape="RoundRectangle 14" Stroke="#2A2A2A" BackgroundColor="#0D0D0D"
                            Padding="16,20" IsVisible="False" HorizontalOptions="Center" MinimumWidthRequest="260">
                        <VerticalStackLayout Spacing="8" HorizontalOptions="Center">
                            <Image Source="icon_fingerprint.png" WidthRequest="44" HeightRequest="44" HorizontalOptions="Center"/>
                            <Label x:Name="CardWaitingText" Text="Waiting for fingerprint..." TextColor="#FFAA33" FontSize="13" FontAttributes="Bold" HorizontalOptions="Center"/>
                        </VerticalStackLayout>
                    </Border>

                    <!-- Step 3 -->
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Grid.Column="0" x:Name="Step3Icon" StrokeShape="RoundRectangle 16" Stroke="#2A2A2A" BackgroundColor="#1A1A1A" HeightRequest="32" WidthRequest="32">
                            <Label x:Name="Step3IconLabel" Text="3" FontSize="13" TextColor="#555555" HorizontalOptions="Center" VerticalOptions="Center"/>
                        </Border>
                        <VerticalStackLayout Grid.Column="1" VerticalOptions="Center" Spacing="2">
                            <Label x:Name="Step3Title" Text="Finalizing" TextColor="#555555" FontSize="14" FontAttributes="Bold"/>
                            <Label x:Name="Step3Subtitle" Text="Waiting..." TextColor="#444444" FontSize="11"/>
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Result banner -->
                    <Border x:Name="ResultBanner" StrokeShape="RoundRectangle 12" Stroke="Transparent" BackgroundColor="#1A3A10" Padding="14,12" IsVisible="False">
                        <HorizontalStackLayout Spacing="10" HorizontalOptions="Center">
                            <Label x:Name="ResultIcon" Text="✓" FontSize="20" FontAttributes="Bold" TextColor="#DEFF9A" VerticalOptions="Center"/>
                            <Label x:Name="ResultText" Text="Enrolled successfully!" TextColor="#DEFF9A" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>
                        </HorizontalStackLayout>
                    </Border>

                    <!-- Technical log (collapsible) -->
                    <VerticalStackLayout Spacing="4">
                        <Button x:Name="BtnToggleLog" Text="▶ Technical details" BackgroundColor="Transparent" TextColor="#555555"
                                FontSize="11" HorizontalOptions="Start" Padding="0" HeightRequest="28" Clicked="OnToggleLogClicked"/>
                        <Border x:Name="LogDetailBox" StrokeShape="RoundRectangle 8" Stroke="#1E3A10" BackgroundColor="#0D0D0D"
                                Padding="10,8" HeightRequest="100" IsVisible="False" StrokeThickness="1">
                            <Editor x:Name="TxtEnrollTerminal" IsReadOnly="True" BackgroundColor="#0D0D0D" TextColor="#50FF50"
                                    FontFamily="Consolas" FontSize="10" VerticalOptions="Fill"/>
                        </Border>
                    </VerticalStackLayout>

                    <Button x:Name="BtnCloseEnroll" Text="CLOSE" BackgroundColor="#2A2A2A" TextColor="#AAAAAA"
                            FontAttributes="Bold" FontSize="13" CornerRadius="12" HeightRequest="44" Clicked="OnCloseOverlay" Margin="0,4,0,0"/>
                </VerticalStackLayout>
            </Border>
        </Grid>
    </Grid>
</ContentPage>
