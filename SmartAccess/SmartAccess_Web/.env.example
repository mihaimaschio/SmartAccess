# Configurare baza de date PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartaccess
DB_USER=postgres
DB_PASS=parola_bazei_de_date

# JWT Secret (schimba cu ceva unic)
JWT_SECRET=cheie_secreta_unica

# IP-ul placutei ESP8266
ESP_IP=http://192.168.0.100

# Adresa fluxului video al modulului ESP32-CAM
CAMERA_URL=http://192.168.0.101:81/stream

# Port server web
PORT=3000

# Email (Gmail — foloseste o App Password, nu parola contului)
# Activeaza App Passwords: myaccount.google.com/apppasswords
SMTP_USER=adresa@gmail.com
SMTP_PASS=app_password_gmail
APP_URL=http://192.168.0.100:3000
